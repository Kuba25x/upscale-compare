{
  "name": "upscale-compare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "db:local": "wrangler d1 migrations apply upscale-compare --local --config worker/wrangler.jsonc",
    "costs:local": "node scripts/configure-local-controls.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "build": "npm run notices && npm run typecheck && vite build && npm run build:worker",
    "build:worker": "esbuild worker/src/index.ts --bundle --format=esm --platform=browser --target=es2022 --external:cloudflare:* --outfile=worker/dist/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build:worker && vitest run",
    "test:e2e": "playwright test",
    "test:sharing:local": "npm run build:worker && node scripts/build-sharing-test.mjs && playwright test --config playwright.sharing.config.ts",
    "check": "npm run build && npm test && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notices": "node scripts/generate-notices.mjs",
    "typecheck:frontend": "tsc --noEmit",
    "build:demo": "npm run notices && npm run typecheck:frontend && vite build --mode demo",
    "dev:demo": "vite --host 0.0.0.0 --mode demo",
    "test:demo": "npm run build:demo && playwright test --config playwright.demo.config.ts",
    "test:diagnostics": "playwright test --config playwright.diagnostics.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "miniflare": "5.20261023.0-beta",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}
